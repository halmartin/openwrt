[ -f /etc/config/ubootenv ] && exit 0

touch /etc/config/ubootenv

. /lib/uboot-envtools.sh
. /lib/functions.sh

board=$(board_name)

case "$board" in
	watchguard,firebox-t20|\
	watchguard,firebox-t20-w|\
	watchguard,firebox-t40-w|\
	watchguard,firebox-t40)
		ubootenv_add_uci_config "/dev/mtd2" "0x0000" "0x2000" "0x1000"
	;;
	traverse,ten64)
		ubootenv_add_uci_config "/dev/mtd3" "0x0000" "0x80000" "0x80000"
	;;
esac

config_load ubootenv
config_foreach ubootenv_add_app_config ubootenv

exit 0
