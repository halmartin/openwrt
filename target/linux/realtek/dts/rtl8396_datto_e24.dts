/dts-v1/;

#include "rtl839x.dtsi"

#include <dt-bindings/input/input.h>
#include <dt-bindings/gpio/gpio.h>

/ {
	compatible = "datto,e24v3", "realtek,rtl8396-soc";
	model = "Datto E24v3";

	aliases {
		led-boot = &led_sys;
		led-failsafe = &led_sys;
		led-running = &led_sys;
		led-upgrade = &led_sys;
	};

	/* TODO: E24v3 has 256MB */
	memory@0 {
		device_type = "memory";
		reg = <0x0 0x10000000>;
	};

	leds {
		pinctrl-names = "default";
		pinctrl-0 = <&pinmux_disable_sys_led>;
		compatible = "gpio-leds";

		led_sys: sys {
			label = "green:sys";
			gpios = <&gpio0 0 GPIO_ACTIVE_HIGH>;
		};
	};

	keys {
		compatible = "gpio-keys";

		reset {
			label = "reset";
			gpios = <&gpio0 18 GPIO_ACTIVE_LOW>;
			linux,code = <KEY_RESTART>;
			debounce-interval = <100>;
		};

		mode {
			label = "mode";
			gpios = <&gpio0 17 GPIO_ACTIVE_LOW>;
			linux,code = <KEY_LIGHTS_TOGGLE>;
			debounce-interval = <100>;
		};
	};

	/* LM63 */
	i2c-gpio-2 {
		compatible = "i2c-gpio";
		sda-gpios = <&gpio0 14 (GPIO_ACTIVE_HIGH | GPIO_OPEN_DRAIN)>;
		scl-gpios = <&gpio0 13 GPIO_ACTIVE_HIGH>;
		i2c-gpio,delay-us = <2>;
		i2c-gpio,scl-open-drain; /* should be replaced by i2c-gpio,scl-has-no-pullup in kernel 6.6 */
		#address-cells = <1>;
		#size-cells = <0>;

		lm63@4c {
			compatible = "national,lm63";
			reg = <0x4c>;
		};
	};
};

&mdio_aux {
	status = "okay";

	gpio1: expander@0 {
		compatible = "realtek,rtl8231";
		reg = <0>;

		gpio-controller;
		#gpio-cells = <2>;
		gpio-ranges = <&gpio1 0 0 37>;

		led-controller {
			compatible = "realtek,rtl8231-leds";
			status = "disabled";
		};
	};
};

&spi0 {
	status = "okay";
	flash@0 {
		compatible = "jedec,spi-nor";
		reg = <0>;
		spi-max-frequency = <10000000>;

		partitions {
			compatible = "fixed-partitions";
			#address-cells = <1>;
			#size-cells = <1>;

			partition@0 {
				label = "u-boot";
				reg = <0x0 0x80000>;
				read-only;
			};
			partition@80000 {
				label = "u-boot-env";
				reg = <0x80000 0x10000>;
			};
			partition@90000 {
				label = "u-boot-env2";
				reg = <0x90000 0x20000>;
			};
			partition@a0000 {
				label = "cfg";
				reg = <0xa0000 0x400000>;
			};
			partition@4a0000 {
				label = "log";
				reg = <0x4a0000 0x100000>;
			};
			partition@5a0000 {
				label = "firmware";
				reg = <0x5a0000 0x1a60000>;
				compatible = "openwrt,uimage", "denx,uimage";
				openwrt,ih-magic = <0x00702202>;
			};
		};
	};
};

&mdio_bus0 {
	/* External phy RTL8218B #1 */
	PHY_C22(0,0)
	PHY_C22(1,1)
	PHY_C22(2,2)
	PHY_C22(3,3)
	PHY_C22(4,4)
	PHY_C22(5,5)
	PHY_C22(6,6)
	PHY_C22(7,7)

	/* External phy RTL8218B #2 */
	PHY_C22(8,8)
	PHY_C22(9,9)
	PHY_C22(10,10)
	PHY_C22(11,11)
	PHY_C22(12,12)
	PHY_C22(13,13)
	PHY_C22(14,14)
	PHY_C22(15,15)

	/* External phy RTL8218B #3 */
	PHY_C22(16,16)
	PHY_C22(17,17)
	PHY_C22(18,18)
	PHY_C22(19,19)
	PHY_C22(20,20)
	PHY_C22(21,21)
	PHY_C22(22,22)
	PHY_C22(23,23)
};

&uart1 {
	status = "okay";
};

&switch0 {
	ethernet-ports {
		#address-cells = <1>;
		#size-cells = <0>;

		SWITCH_PORT(0, 1, qsgmii)
		SWITCH_PORT(1, 2, qsgmii)
		SWITCH_PORT(2, 3, qsgmii)
		SWITCH_PORT(3, 4, qsgmii)
		SWITCH_PORT(4, 5, qsgmii)
		SWITCH_PORT(5, 6, qsgmii)
		SWITCH_PORT(6, 7, qsgmii)
		SWITCH_PORT(7, 8, qsgmii)

		SWITCH_PORT(8, 9, qsgmii)
		SWITCH_PORT(9, 10, qsgmii)
		SWITCH_PORT(10, 11, qsgmii)
		SWITCH_PORT(11, 12, qsgmii)
		SWITCH_PORT(12, 13, qsgmii)
		SWITCH_PORT(13, 14, qsgmii)
		SWITCH_PORT(14, 15, qsgmii)
		SWITCH_PORT(15, 16, qsgmii)

		SWITCH_PORT(16, 17, qsgmii)
		SWITCH_PORT(17, 18, qsgmii)
		SWITCH_PORT(18, 19, qsgmii)
		SWITCH_PORT(19, 20, qsgmii)
		SWITCH_PORT(20, 21, qsgmii)
		SWITCH_PORT(21, 22, qsgmii)
		SWITCH_PORT(22, 23, qsgmii)
		SWITCH_PORT(23, 24, qsgmii)

		/* CPU-Port */
		port@52 {
			ethernet = <&ethernet0>;
			reg = <52>;
			phy-mode = "internal";
			fixed-link {
				speed = <1000>;
				full-duplex;
			};
		};
	};
};
